---
export interface Props {
  title: string;
  desc: string;
  canonical: string;
  faq?: string;
  breadcrumb?: string;
}
const { title, desc, canonical, faq, breadcrumb } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title>
<meta name="description" content={desc}/>
<link rel="canonical" href={canonical}/>
<meta property="og:type" content="website"/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={desc}/>
<meta property="og:url" content={canonical}/>
<meta property="og:site_name" content="CS2 FAQ Guide"/>
<meta name="twitter:card" content="summary"/>
<meta name="twitter:title" content={title}/>
<meta name="twitter:description" content={desc}/>
<meta name="robots" content="index,follow"/>
{faq && <script type="application/ld+json" set:html={faq}/>}
{breadcrumb && <script type="application/ld+json" set:html={breadcrumb}/>}
<style is:inline>
*{margin:0;padding:0;box-sizing:border-box}
:root{--bg:#0a0e14;--surface:#12171f;--surface2:#1a2030;--border:#262f3d;--text:#d4dce8;--muted:#7a8599;--accent:#4fc3f7;--accent2:#29b6f6;--green:#66bb6a;--yellow:#ffd54f;--red:#ef5350;--purple:#ab47bc;--orange:#ffa726}
body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;line-height:1.7;min-height:100vh;display:flex;flex-direction:column}
a{color:var(--accent);text-decoration:none}a:hover{color:var(--accent2);text-decoration:underline}
nav{background:var(--surface);border-bottom:1px solid var(--border);padding:0.75rem 1.5rem;position:sticky;top:0;z-index:100;display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap}
nav .logo{font-weight:700;font-size:1.1rem;color:var(--accent)}
nav a{color:var(--muted);font-size:0.9rem;transition:color 0.2s}
nav a:hover{color:var(--text);text-decoration:none}
main{flex:1;max-width:900px;width:100%;margin:0 auto;padding:2rem 1.5rem}
.hero{text-align:center;padding:2.5rem 0 2rem}
.hero h1{font-size:2.2rem;margin-bottom:0.75rem;color:var(--text)}
.hero p{color:var(--muted);font-size:1.1rem;max-width:650px;margin:0 auto}
h1{font-size:1.8rem;margin-bottom:1rem;color:var(--text)}
h2{font-size:1.4rem;margin:2rem 0 1rem;color:var(--text)}
h3{font-size:1.15rem;margin:1.5rem 0 0.5rem;color:var(--text)}
p{margin-bottom:1rem;color:var(--muted)}
.card{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:1.25rem 1.5rem;margin-bottom:0.75rem;transition:border-color 0.2s}
.card:hover{border-color:var(--accent)}
.card h3{margin-top:0;margin-bottom:0.3rem}
.card p{margin-bottom:0;font-size:0.9rem}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:0.75rem;margin:1rem 0}
.breadcrumb{font-size:0.85rem;color:var(--muted);margin-bottom:1.5rem}
.breadcrumb a{color:var(--muted)}
.breadcrumb a:hover{color:var(--accent)}
.breadcrumb span{margin:0 0.4rem}
.tag{display:inline-block;background:var(--surface2);color:var(--muted);padding:0.15rem 0.5rem;border-radius:4px;font-size:0.78rem;margin:0.15rem}
.tag-count{background:var(--accent);color:#000;font-weight:600}
.answer-box{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:1.5rem 2rem;margin:1.5rem 0;line-height:1.8}
.answer-box p{color:var(--text);margin-bottom:1rem}
.answer-box p:last-child{margin-bottom:0}
.key-points{margin:1.5rem 0}
.key-points ul{list-style:none;padding:0}
.key-points li{padding:0.4rem 0 0.4rem 1.5rem;position:relative;color:var(--muted)}
.key-points li::before{content:'✓';position:absolute;left:0;color:var(--green);font-weight:700}
.mistakes ul{list-style:none;padding:0}
.mistakes li{padding:0.4rem 0 0.4rem 1.5rem;position:relative;color:var(--muted)}
.mistakes li::before{content:'✗';position:absolute;left:0;color:var(--red);font-weight:700}
.quick-answer{background:var(--surface2);border-left:3px solid var(--accent);padding:1rem 1.25rem;border-radius:0 6px 6px 0;margin:1rem 0;font-size:0.95rem;color:var(--text)}
.quick-answer strong{color:var(--accent);margin-right:0.4rem}
.related-questions{margin:1.5rem 0}
.related-questions .tag{font-size:0.85rem;padding:0.3rem 0.7rem;margin:0.2rem}
.topic-list a{display:block;text-decoration:none}
.topic-list .card{cursor:pointer}
.topic-list .card h3{color:var(--text)}
.search-box{margin:1.5rem 0}
.search-box input{width:100%;background:var(--surface);border:1px solid var(--border);color:var(--text);padding:0.75rem 1rem;border-radius:6px;font-size:1rem;transition:border-color 0.2s}
.search-box input:focus{outline:none;border-color:var(--accent)}
.category-nav{display:flex;flex-wrap:wrap;gap:0.5rem;margin:1.5rem 0}
.category-nav a{display:inline-block;padding:0.4rem 0.8rem;background:var(--surface);border:1px solid var(--border);border-radius:6px;font-size:0.85rem;color:var(--muted);transition:all 0.2s}
.category-nav a:hover{border-color:var(--accent);color:var(--accent);text-decoration:none}
.internal-links{margin:2rem 0;padding:1.5rem;background:var(--surface);border:1px solid var(--border);border-radius:8px}
.internal-links h3{margin-top:0}
.internal-links ul{list-style:none;display:flex;flex-wrap:wrap;gap:0.4rem;padding:0}
.internal-links li a{display:inline-block;padding:0.25rem 0.6rem;background:var(--surface2);border:1px solid var(--border);border-radius:4px;font-size:0.82rem;color:var(--muted)}
.internal-links li a:hover{border-color:var(--accent);color:var(--accent);text-decoration:none}
footer{background:var(--surface);border-top:1px solid var(--border);padding:1.5rem;text-align:center;color:var(--muted);font-size:0.85rem;margin-top:auto}
footer a{color:var(--muted)}footer a:hover{color:var(--accent)}
@media(max-width:768px){
  nav{justify-content:center}
  .hero h1{font-size:1.6rem}
  .grid{grid-template-columns:1fr}
  main{padding:1.5rem 1rem}
  .answer-box{padding:1rem 1.25rem}
}
</style>
</head>
<body>
<nav>
  <a href="/" class="logo">CS2 Guide</a>
  <a href="/">All Topics</a>
  <a href="/getting-started/">Getting Started</a>
  <a href="/gameplay-mechanics/">Gameplay</a>
  <a href="/ranking-system/">Ranking</a>
  <a href="/weapons-recoil/">Weapons</a>
  <a href="/competitive-play/">Competitive</a>
</nav>
<main>
<slot/>
</main>
<footer>
  <p>&copy; 2025 CS2Guide.net — Free CS2 guides, FAQ answers, and tips. Not affiliated with Valve.</p>
  <p style="margin-top:0.5rem">
    <a href="/">Home</a> &middot;
    <a href="/getting-started/">Getting Started</a> &middot;
    <a href="/sensitivity-settings/">Sensitivity</a> &middot;
    <a href="/performance-fps/">Performance</a> &middot;
    <a href="/competitive-play/">Competitive</a> &middot;
    <a href="/advanced-mechanics/">Advanced</a>
  </p>
</footer>
</body>
</html>
